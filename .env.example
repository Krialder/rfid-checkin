# RFID Check-in System - Environment Configuration Template
# Copy this file to .env and configure the values for your environment

# Application Configuration
APP_NAME="RFID Check-in System"
APP_ENV=production
APP_DEBUG=false
APP_VERSION=2.0.0
BASE_URL=http://localhost/rfid-checkin
APP_TIMEZONE=UTC

# Database Configuration
DB_HOST=localhost
DB_NAME=rfid_checkin_system
DB_USER=your_db_user
DB_PASS=your_secure_password
DB_CHARSET=utf8mb4
DB_PORT=3306
DB_TIMEOUT=10
DB_PERSISTENT=false

# Security Configuration
SESSION_LIFETIME=3600
SESSION_REGENERATE_INTERVAL=600
CSRF_TOKEN_LIFETIME=3600
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=60
MAX_REQUESTS_PER_WINDOW=100
SECURITY_HEADERS=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs
LOG_MAX_FILE_SIZE=10485760
LOG_RETENTION_DAYS=30

# Cache Configuration
CACHE_ENABLED=true
CACHE_TYPE=file
CACHE_FILE_PATH=./cache
CACHE_DEFAULT_TTL=300

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx
UPLOAD_PATH=./uploads
TEMP_PATH=/tmp

# Email Configuration (Optional)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME="RFID Check-in System"

# API Configuration
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=60
API_PAGINATION_DEFAULT_LIMIT=20
API_PAGINATION_MAX_LIMIT=100

# Hardware Configuration
RFID_ENABLED=true
DEVICE_TIMEOUT=30
MAX_DEVICES=50

# Feature Flags
FEATURE_USER_REGISTRATION=true
FEATURE_PASSWORD_RESET=true
FEATURE_ANALYTICS=true
FEATURE_NOTIFICATIONS=true
FEATURE_REPORTING=true
FEATURE_BULK_OPERATIONS=true

# Development-specific settings (only use in development)
# DEBUG_MODE=true
# LOG_LEVEL=DEBUG
# CACHE_ENABLED=false
# RATE_LIMIT_ENABLED=false